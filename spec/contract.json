{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgriPreneursModuleContract",
  "version": "1.0.0",
  "description": "Standard event and API contract specification for AgriPreneurs buildathon modules.",
  "events": {
    "telemetry.evaluated.v1": {
      "type": "object",
      "required": ["event_id", "timestamp", "soil_moisture_pct", "trigger_irrigation", "urgency"],
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "timestamp": { "type": "string", "format": "date-time" },
        "farmer_id": { "type": "string" },
        "soil_moisture_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "trigger_irrigation": { "type": "boolean" },
        "urgency": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] }
      }
    }
  }
}
