# ==============================================================================
# Agripreneurs Buildathon - Environment Variables Template
# Copy this file to .env and fill in your values: cp .env.example .env
# NOTE: NEVER COMMIT YOUR .env FILE OR REAL API KEYS TO GITHUB!
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=True
PORT=8000

# Backend / Database (Optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/agri_db
# REDIS_URL=redis://localhost:6379/0

# IoT / MQTT Broker (if using hardware/telemetry)
MQTT_BROKER_URL=mqtt://broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=agripreneurs/team_name/

# External APIs (Weather, Soil, Satellite, LLMs)
# OPENWEATHER_API_KEY=your_openweather_api_key_here
# AGROMONITORING_API_KEY=your_agromonitoring_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Hardware Serial / Communication Settings
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=115200
